# Public listener inside the container.
HOST=0.0.0.0
PORT=3001

# Required auth service used to verify room-creator bearer tokens.
AUTH_BASE_URL=https://auth.example.invalid
AUTH_VERIFY_PATH=/whoami

# Exact comma-separated browser origins; no paths or trailing wildcards.
ALLOWED_ORIGINS=https://play.example.invalid

# Required for durable rooms. Mount a persistent single-writer volume here.
ROOMS_DATA_FILE=/data/rooms.json

# Optional diagnostic logging. Avoid enabling permanently in production.
ROOMS_API_VERBOSE_LOGS=0
