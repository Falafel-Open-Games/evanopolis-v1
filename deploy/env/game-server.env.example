# Public listener inside the container.
HOST=0.0.0.0
PORT=8788

# Required for production paid-room lookup and admission.
EVANOPOLIS_ROOMS_API_URL=https://rooms.example.invalid
EVANOPOLIS_AUTH_API_URL=https://auth.example.invalid

# Immutable release/build label returned by GET /health.
EVANOPOLIS_BUILD_VERSION=REQUIRED_RELEASE_BUILD_VERSION

# Optional. Set to 0 to suppress accepted-command event logging.
EVANOPOLIS_SERVER_LOGS=1

# Development-only. Do not enable in production.
EVANOPOLIS_ALLOW_CLIENT_RANDOM_SEED=0
