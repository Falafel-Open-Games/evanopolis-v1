# Handoff inventory only. The pinned tabletop-auth revision's .env.example is
# authoritative and must be reconciled before deployment.
PORT=3000

# Secrets: inject with the target platform secret manager.
JWT_PRIVATE_KEY_PEM=REQUIRED_SECRET
JWT_PUBLIC_KEY_PEM=REQUIRED_SECRET_OR_MANAGED_PUBLIC_VALUE
JWT_KEY_ID=auth-eddsa
JWT_ACCESS_TOKEN_TTL_SECONDS=900
NONCE_STORE_URL=REQUIRED_SECRET_REDIS_URL
DATABASE_URL=REQUIRED_SECRET_POSTGRES_URL
EVM_RPC_URL=REQUIRED_SECRET_RPC_URL

# Exact browser origins allowed to call auth/payment endpoints.
ALLOWED_ORIGINS=https://play.example.invalid

# Payment network and verification policy. Values must match the approved
# environment and the wrapper contract configuration.
CHAIN_ID=421614
CHAIN_IDS=421614
PAYMENT_MIN_CONFIRMATIONS=3
PAYMENT_ADAPTER_ADDRESS=REQUIRED_APPROVED_CONTRACT_ADDRESS

# Never enable in production without an explicit security decision.
ALLOW_EXPIRED_JWT=
