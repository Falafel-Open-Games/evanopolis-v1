# Public DNS names pointing to this EC2 instance.
WEB_DOMAIN=play.CHANGE_ME
AUTH_DOMAIN=auth.CHANGE_ME
ROOMS_DOMAIN=rooms.CHANGE_ME
GAME_DOMAIN=game.CHANGE_ME

# This is a new internal database password; it is not supplied by AWS.
# Generate it on the server with: openssl rand -hex 24
# Keep the same value after the first start because PostgreSQL stores it in its
# persistent Docker volume.
POSTGRES_PASSWORD=CHANGE_ME

JWT_KEY_ID=auth-eddsa

# Current RC.2 payment environment. Replace the RPC URL.
CHAIN_ID=421614
CHAIN_IDS=421614
EVM_RPC_URL="CHANGE_ME"
PAYMENT_MIN_CONFIRMATIONS=3
PAYMENT_ADAPTER_ADDRESS=0x6863896de06241853470205f2df5d6a76f491fe1
