{$WEB_DOMAIN} {
    root * /srv/web
    encode zstd gzip

    @html path *.html /
    header @html Cache-Control "no-cache"

    @godotEngine path /game/index.js /game/index.wasm
    header @godotEngine Cache-Control "public, max-age=0, must-revalidate"

    @versionedPack path_regexp versionedPack ^/game/index-[a-z0-9-]+\.pck$
    header @versionedPack Cache-Control "public, max-age=31536000, immutable"

    try_files {path} /room-entry.html
    file_server
}

{$AUTH_DOMAIN} {
    reverse_proxy auth:3000
}

{$ROOMS_DOMAIN} {
    reverse_proxy rooms:3001
}

{$GAME_DOMAIN} {
    reverse_proxy game:8788
}
